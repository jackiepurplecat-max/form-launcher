{
  "name": "helpfulforms",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build.js",
    "build:watch": "nodemon --watch form-launcher/.env --watch form-launcher/index.template.html --exec npm run build",
    "start": "python3 -m http.server 8000 --directory form-launcher",
    "dev": "npm run build && npm start",
    "clasp:login": "clasp login",
    "clasp:logout": "clasp logout",
    "clasp:create": "clasp create",
    "clasp:clone": "clasp clone",
    "clasp:push": "clasp push",
    "clasp:pull": "clasp pull",
    "clasp:open": "clasp open-script",
    "clasp:status": "clasp status",
    "clasp:deploy": "clasp deploy",
    "clasp:version": "clasp version",
    "v2:test": "node v2/test/run.js",
    "v2:check": "node --check v2/Config.js && node --check v2/Core.js && node --check v2/Entries.js && node --check v2/Registry.js && node --check v2/Setup.js && node --check v2/Smoke.js",
    "v2:push": "cd v2 && clasp --user v2 push",
    "v2:pull": "cd v2 && clasp --user v2 pull",
    "v2:open": "cd v2 && clasp --user v2 open-script",
    "v2:status": "cd v2 && clasp --user v2 status",
    "v2:login": "clasp login --user v2",
    "v2:whoami": "cd v2 && clasp --user v2 show-authorized-user",
    "v2:push:force": "cd v2 && clasp --user v2 push --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@google/clasp": "^3.0.6-alpha"
  }
}
