# Pushed to the NEW account's project only. The root .claspignore covers the
# old account and allows only the frozen Code.js, so the two cannot cross.
#
# THIS IS A DENY-ALL WITH AN ALLOWLIST. A new file in v2/ that is not named
# below is silently left behind, and `clasp push` still reports success - it
# prints the count of what it DID send, which reads as a complete push. Add the
# file here at the same time you create it, and check the count.
**/**
!Config.js
!Core.js
!Entries.js
!Registry.js
!Setup.js
!Smoke.js
!Web.js
!Form.js
!Manage.js
!Suppliers.js
!Siri.js
!IvaExport.js
!Index.html
!appsscript.json
